{
  "expo": {
    "name": "ClearScan",
    "slug": "clear-scan",
    "scheme": "clearscan",
    "description": "ClearScan turns your iPhone into a fast, clean document scanner. Text is read on your device so you can search inside every scan. No watermark, no account, no ads.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#062A2A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.samayhuf.clearscan",
      "buildNumber": "5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "ClearScan uses the camera to scan your documents. Images stay on your iPhone.",
        "NSPhotoLibraryUsageDescription": "Choose photos from your library to turn into PDFs. Images stay on your iPhone.",
        "NSFaceIDUsageDescription": "Use Face ID to keep your scans private."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "0A2A.1",
              "3B52.1",
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "85F4.1",
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.samayhuf.clearscan",
      "adaptiveIcon": {
        "backgroundColor": "#062A2A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#062A2A"
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "ClearScan uses the camera to scan your documents. Images stay on your iPhone."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to keep your scans private."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos from your library to turn into PDFs. Images stay on your iPhone."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/no-push-entitlement.js",
      [
        "expo-notifications",
        {
          "color": "#0E8F7E"
        }
      ],
      "expo-font"
    ],
    "owner": "krosz",
    "extra": {
      "eas": {
        "projectId": "74c30f0c-e7cb-4532-80eb-32656208efc8"
      },
      "privacyPolicyUrl": "https://samayhuf-star.github.io/Clear-Scan/"
    }
  }
}
